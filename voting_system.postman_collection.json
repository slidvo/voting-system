    {
      "name": "Poll",
      "item": [
        {
          "name": "Create poll",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Favourite programming language\",\n  \"description\": \"Vote for your favourite language\",\n  \"questions\": [\n    {\n      \"text\": \"Which language do you use most?\",\n      \"options\": [\n        { \"text\": \"JavaScript\" },\n        { \"text\": \"TypeScript\" },\n        { \"text\": \"Python\" },\n        { \"text\": \"Go\" }\n      ]\n    },\n    {\n      \"text\": \"Which language would you like to learn?\",\n      \"options\": [\n        { \"text\": \"Rust\" },\n        { \"text\": \"Kotlin\" },\n        { \"text\": \"Swift\" }\n      ]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{host}}/poll",
              "host": ["{{host}}"],
              "path": ["poll"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Poll ID saved\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.collectionVariables.set(\"pollId\", json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
